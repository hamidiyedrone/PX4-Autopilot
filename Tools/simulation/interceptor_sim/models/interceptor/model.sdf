    <!-- Storm32 3-Axis Gimbal: Yaw Joint & Link (Pan +/- 45 deg around fuselage z) -->
    <link name="gimbal_yaw_link">
      <pose>0.0380 0 0.5015 0 0 0</pose>
      <inertial>
        <mass>0.0900</mass>
        <inertia>
