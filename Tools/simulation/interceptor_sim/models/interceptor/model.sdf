        <pose>-0.006 0 -0.020 0 0 0</pose>
        <geometry><box><size>0.020 0.022 0.012</size></box></geometry>
        <material><ambient>0.08 0.08 0.10 1</ambient><diffuse>0.08 0.08 0.10 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
